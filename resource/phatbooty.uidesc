<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts>
		<font font-name="Sans" name="Title" size="30" bold="true"/>
		<font font-name="Sans" name="Section" size="12" bold="true"/>
		<font font-name="Sans" name="Label" size="10" bold="true"/>
		<font font-name="Sans" name="Value" size="11"/>
		<font font-name="Monospace" name="SeedFont" size="18" bold="true"/>
	</fonts>
	<colors>
		<color name="Bg" rgba="#130b1bff"/>
		<color name="Panel" rgba="#211331ff"/>
		<color name="PanelEdge" rgba="#3a2552ff"/>
		<color name="Field" rgba="#0e0815ff"/>
		<color name="Text" rgba="#f4ecffff"/>
		<color name="TextDim" rgba="#9b87b5ff"/>
		<color name="Pink" rgba="#ff3d8bff"/>
		<color name="Orange" rgba="#ffb52eff"/>
		<color name="Cyan" rgba="#3de8ffff"/>
		<color name="KnobTrack" rgba="#3a2552ff"/>
	</colors>
	<gradients>
		<gradient name="ButtonOff"><color-stop rgba="#2b1a3dff" start="0"/><color-stop rgba="#1b0f27ff" start="1"/></gradient>
		<gradient name="ButtonOn"><color-stop rgba="#ffc85aff" start="0"/><color-stop rgba="#ff8a1eff" start="1"/></gradient>
	</gradients>
	<control-tags>
		<control-tag name="P::Groove" tag="0"/>
		<control-tag name="P::Seed" tag="1"/>
